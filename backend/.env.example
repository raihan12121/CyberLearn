# CyberLearn Backend Environment Configuration
# Copy this file to .env and fill in the values.
#
# Generate secure keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# JWT signing key for authentication tokens (REQUIRED for production)
SECRET_KEY=your-secret-key-here

# Secret used to generate deterministic CTF lab flags via HMAC-SHA256 (REQUIRED for production)
FLAG_SECRET=your-flag-secret-here

# Database connection string
# DATABASE_URL=postgresql://cyberuser:cyberpassword@localhost:5432/cyberdb

# Google Gemini API Key for AI Cyber Coach
GEMINI_API_KEY=your-gemini-api-key-here

